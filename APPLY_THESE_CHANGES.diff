 @export var entries: Array[LootEntry] = []
 
 
+## Weighted pick. Returns null on an empty table rather than indexing off the end.
 func roll() -> LootEntry:
+	if entries.is_empty():
+		return null
+
 	var total := 0
 	for e in entries:
 		total += e.weight
+	if total <= 0:
